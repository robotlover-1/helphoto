# 复制为 .env 后填入真实值（.env 不提交）

# AI provider：deepseek（默认）或 anthropic
AI_PROVIDER=deepseek

# DeepSeek：必须用支持图片输入的模型，deepseek-flash（V4.1）可用；
# deepseek-v4-pro、旧版 deepseek-chat 等文本模型不接受图片。
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Anthropic（仅 AI_PROVIDER=anthropic 时使用）
ANTHROPIC_API_KEY=

PORT=8787
